# ─── Database ─────────────────────────────────────────────────────────────────
# Railway Postgres connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/niche_factory

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Random secret: openssl rand -base64 32
AUTH_SECRET=replace-me-with-random-secret
# Notion OAuth app — create at https://www.notion.so/profile/integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ─── AI ───────────────────────────────────────────────────────────────────────
# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Notion ───────────────────────────────────────────────────────────────────
# Fallback server-level Notion token (used when no user session token available)
NOTION_TOKEN=secret_...

# ─── Niche adapter credentials (per-customer in production, dev values here) ──
# Required by niches/real-estate-investor/sources/propstream.ts
PROPSTREAM_API_KEY=
