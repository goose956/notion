{
  "version": "1.0.0",
  "id": "teacher",
  "name": "Teacher Planning OS",
  "description": "AI builds your lesson plans, writes student report comments, and creates assessments — so you can focus on teaching, not paperwork.",
  "databases": [
    {
      "id": "documents",
      "name": "Planning Documents",
      "properties": [
        { "name": "Title",   "type": "title" },
        { "name": "Type",    "type": "select", "options": [{ "name": "Lesson Plan", "color": "blue" }, { "name": "Report Comment", "color": "green" }, { "name": "Assessment", "color": "orange" }] },
        { "name": "Subject", "type": "select", "options": [{ "name": "English" }, { "name": "Maths" }, { "name": "Science" }, { "name": "History" }, { "name": "Geography" }, { "name": "Art" }, { "name": "PE" }, { "name": "Music" }, { "name": "Computing" }, { "name": "Languages" }, { "name": "PSHE" }, { "name": "Other" }] },
        { "name": "Year Group", "type": "select", "options": [{ "name": "Year 1" }, { "name": "Year 2" }, { "name": "Year 3" }, { "name": "Year 4" }, { "name": "Year 5" }, { "name": "Year 6" }, { "name": "Year 7" }, { "name": "Year 8" }, { "name": "Year 9" }, { "name": "Year 10" }, { "name": "Year 11" }, { "name": "Year 12" }, { "name": "Year 13" }] },
        { "name": "Content", "type": "rich_text" }
      ]
    }
  ],
  "onboardingQuestions": [
    {
      "id": "school-name",
      "question": "What is your school called?",
      "type": "text",
      "required": false,
      "hint": "e.g. Oakwood Primary, St. Mary's Secondary"
    },
    {
      "id": "subject",
      "question": "What subject(s) do you teach?",
      "type": "text",
      "required": true,
      "hint": "e.g. English, Maths, Science, History"
    },
    {
      "id": "year-groups",
      "question": "Which year groups do you teach?",
      "type": "text",
      "required": true,
      "hint": "e.g. Year 7–9, KS2, Year 10 and 11"
    },
    {
      "id": "curriculum",
      "question": "Which curriculum do you follow?",
      "type": "select",
      "options": ["England (National Curriculum)", "Scotland (Curriculum for Excellence)", "Wales (Curriculum for Wales)", "Northern Ireland", "Australian Curriculum", "US Common Core", "IB (International Baccalaureate)", "Other"],
      "required": true
    }
  ]
}
