{
  "version": "1.0.0",
  "id": "local-business-lead-tracker",
  "name": "Local Business Lead Tracker",
  "description": "Find and track local business leads by keyword and location. Built for outbound teams that need fresh lead lists with contact details and qualification status.",
  "tagline": "Search once, qualify fast, and run outreach from one Notion workspace.",
  "databases": [
    {
      "id": "leads",
      "name": "Leads",
      "description": "Local business leads discovered from Google Maps/Places searches.",
      "icon": "📇",
      "properties": [
        { "type": "title", "name": "Business Name" },
        { "type": "rich_text", "name": "Primary Category" },
        { "type": "url", "name": "Website" },
        { "type": "phone_number", "name": "Phone" },
        { "type": "rich_text", "name": "Address" },
        { "type": "rich_text", "name": "City" },
        { "type": "rich_text", "name": "Country" },
        { "type": "number", "name": "Rating", "format": "number" },
        { "type": "number", "name": "Reviews", "format": "number" },
        { "type": "url", "name": "Google Maps URL" },
        { "type": "rich_text", "name": "Google Place ID" },
        { "type": "status", "name": "Status" },
        { "type": "formula", "name": "Lead Score", "expression": "round(prop(\"Rating\") * 20)" },
        { "type": "date", "name": "Imported At" },
        { "type": "rich_text", "name": "Source" },
        { "type": "rich_text", "name": "Notes" }
      ],
      "views": [
        { "name": "All Leads", "type": "table" },
        { "name": "By Status", "type": "board", "groupByProperty": "Status" }
      ]
    }
  ],
  "dataSources": [
    {
      "id": "apify-google-places",
      "label": "Apify Google Places",
      "description": "Runs an Apify actor to collect local business leads from Google Maps queries.",
      "stubFile": "sources/apify-google-places.ts",
      "requiredCredentials": [],
      "targetDatabaseId": "leads",
      "schedule": "daily"
    }
  ],
  "onboardingQuestions": [
    {
      "id": "lead-keywords",
      "question": "Which business types are you targeting?",
      "type": "text",
      "required": true,
      "hint": "Comma separated, e.g. dentist, orthodontist, dental clinic"
    },
    {
      "id": "target-locations",
      "question": "Which locations should be searched?",
      "type": "text",
      "required": true,
      "hint": "Comma separated, e.g. London, Birmingham, Manchester"
    },
    {
      "id": "country-filter",
      "question": "Limit results to a country?",
      "type": "select",
      "options": ["Any", "US", "UK"],
      "required": false
    },
    {
      "id": "min-rating",
      "question": "Minimum rating (0-5)?",
      "type": "number",
      "required": false,
      "hint": "Example: 4.2"
    },
    {
      "id": "min-reviews",
      "question": "Minimum review count?",
      "type": "number",
      "required": false,
      "hint": "Example: 20"
    },
    {
      "id": "max-results",
      "question": "Maximum results per sync run?",
      "type": "number",
      "required": false,
      "hint": "Example: 100"
    }
  ]
}
