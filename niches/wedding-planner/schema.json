        { "Task": "Create day-of timeline and share with vendors", "Category": "On the Day", "When": "2–4 weeks before", "High Priority": true },
        { "Task": "Prepare final vendor payments", "Category": "Legal & Admin", "When": "2–4 weeks before", "High Priority": true },
        { "Task": "Pack for honeymoon", "Category": "Honeymoon", "When": "2–4 weeks before", "High Priority": false },
        { "Task": "Wedding rehearsal", "Category": "On the Day", "When": "Week of", "High Priority": true },
        { "Task": "Deliver decorations and items to venue", "Category": "On the Day", "When": "Week of", "High Priority": false },
