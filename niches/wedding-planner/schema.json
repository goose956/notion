    {
      "id": "documents",
      "name": "Documents",
      "description": "AI-drafted letters, emails, and notes saved from the research chatbot.",
      "icon": "📄",
      "cover": {
        "type": "external",
        "url": "https://images.unsplash.com/photo-1505932794465-147d1f1b2c97?w=1920&q=80"
      },
      "properties": [
        { "type": "title", "name": "Title" },
        {
          "type": "select",
          "name": "Type",
          "options": [
            { "name": "Venue Enquiry", "color": "purple" },
            { "name": "Vendor Enquiry", "color": "pink" },
            { "name": "Contract Note", "color": "orange" },
            { "name": "AI Research", "color": "blue" },
            { "name": "Guest Communication", "color": "green" },
            { "name": "Other", "color": "default" }
          ]
        },
        { "type": "date", "name": "Created" },
        { "type": "rich_text", "name": "Recipient" },
        { "type": "rich_text", "name": "Subject" },
        { "type": "rich_text", "name": "Body" },
        { "type": "rich_text", "name": "Summary" }
      ],
      "views": [
        { "name": "All Documents", "type": "table" },
        { "name": "By Type", "type": "board", "groupByProperty": "Type" }
      ]
    }
  ],
  "dataSources": [
    {
      "id": "vendor-web-search",
      "label": "AI Vendor Search",
      "description": "Uses the research chatbot to find and shortlist local wedding vendors by category and location. Results are saved directly to the Vendors database.",
      "stubFile": "sources/vendor-web-search.ts",
      "requiredCredentials": [],
      "targetDatabaseId": "vendors",
      "schedule": "manual"
    },
    {
      "id": "guest-import",
      "label": "Guest List Import",
      "description": "Import guests from a CSV or via chatbot conversation. Each guest is added as a row in the Guest List database.",
      "stubFile": "sources/guest-import.ts",
      "requiredCredentials": [],
      "targetDatabaseId": "guests",
      "schedule": "manual"
    }
  ],
  "onboardingQuestions": [
    {
      "id": "wedding-date",
      "question": "What is your wedding date (or approximate timeframe)?",
      "type": "text",
      "required": true,
      "hint": "e.g. 14 June 2026 or 'Summer 2026'"
    },
    {
      "id": "wedding-location",
      "question": "Where are you getting married? (town, city, or region)",
      "type": "text",
      "required": true,
      "hint": "e.g. Cotswolds, Edinburgh, Bristol"
    },
    {
      "id": "guest-count",
      "question": "Roughly how many guests are you inviting?",
      "type": "number",
      "required": true,
      "hint": "e.g. 80"
    },
    {
      "id": "total-budget",
      "question": "What is your total wedding budget?",
      "type": "number",
      "required": true,
      "hint": "Enter in £, e.g. 15000"
    },
    {
      "id": "wedding-style",
      "question": "How would you describe your wedding style?",
      "type": "select",
      "options": ["Rustic / Barn", "Classic / Traditional", "Modern / Minimalist", "Boho / Wildflower", "Black Tie / Formal", "Outdoor / Festival", "Intimate / Micro-wedding", "Not sure yet"],
      "required": false
    },
    {
      "id": "priority-vendors",
      "question": "Which vendors are you most urgently looking for right now?",
      "type": "multi_select",
      "options": ["Venue", "Florist", "Photographer", "Caterer", "Music / DJ", "Cake", "Hair & Makeup", "Videographer", "Transport"],
      "required": false
    }
  ]
}
