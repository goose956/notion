{
  "version": "1.0.0",
  "id": "wedding-planner",
  "name": "Wedding Planner",
  "description": "An AI-assisted wedding planning workspace for brides. Research vendors, track your budget, manage your guest list, and keep every task on schedule — all from one Notion workspace powered by a research chatbot.",
  "tagline": "Plan your perfect day. Every vendor, guest, and task in one place.",
  "cover": {
    "type": "external",
    "url": "https://images.unsplash.com/photo-1519225421980-715cb0215aed?w=1920&q=80"
  },
  "icon": "💍",
  "databases": [
    {
      "id": "vendors",
      "name": "Vendors",
      "description": "Every supplier and service provider considered or booked for the wedding.",
      "icon": "💐",
      "cover": {
        "type": "external",
        "url": "https://images.unsplash.com/photo-1490750967868-88df5691cc11?w=1920&q=80"
      },
      "properties": [
        { "type": "title", "name": "Vendor Name" },
        {
          "type": "select",
          "name": "Category",
          "options": [
            { "name": "Florist", "color": "pink" },
            { "name": "Venue", "color": "purple" },
            { "name": "Catering", "color": "orange" },
            { "name": "Photography", "color": "blue" },
            { "name": "Videography", "color": "blue" },
            { "name": "Music / DJ", "color": "yellow" },
            { "name": "Cake", "color": "pink" },
            { "name": "Hair & Makeup", "color": "red" },
            { "name": "Dress / Attire", "color": "purple" },
            { "name": "Transport", "color": "gray" },
            { "name": "Stationery", "color": "brown" },
            { "name": "Officiant", "color": "green" },
            { "name": "Other", "color": "default" }
          ]
        },
        {
          "type": "status",
          "name": "Status",
          "options": [
            { "name": "Shortlisted", "color": "yellow" },
            { "name": "Contacted", "color": "blue" },
            { "name": "Quote Received", "color": "orange" },
            { "name": "Booked", "color": "green" },
            { "name": "Rejected", "color": "red" }
          ]
        },
        { "type": "number", "name": "Quoted Price", "format": "pound" },
        { "type": "number", "name": "Deposit Paid", "format": "pound" },
        { "type": "checkbox", "name": "Deposit Confirmed" },
        { "type": "url", "name": "Website" },
        { "type": "email", "name": "Email" },
        { "type": "phone_number", "name": "Phone" },
        { "type": "rich_text", "name": "Address" },
        { "type": "rich_text", "name": "Location" },
        { "type": "number", "name": "Rating", "format": "number" },
        { "type": "url", "name": "Reviews URL" },
        { "type": "rich_text", "name": "Notes" },
        { "type": "date", "name": "Follow-up Date" },
        { "type": "date", "name": "Added" },
        { "type": "rich_text", "name": "Source" }
      ],
      "views": [
        { "name": "All Vendors", "type": "table" },
        { "name": "By Category", "type": "board", "groupByProperty": "Category" },
        { "name": "Booked", "type": "table", "filters": [{ "propertyName": "Status", "condition": "equals", "value": "Booked" }] },
        { "name": "Shortlist", "type": "table", "filters": [{ "propertyName": "Status", "condition": "equals", "value": "Shortlisted" }] }
      ]
    },
    {
      "id": "budget",
      "name": "Budget",
      "description": "Track every wedding cost — estimated vs actual — broken down by category.",
      "icon": "💷",
      "cover": {
        "type": "external",
        "url": "https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1920&q=80"
      },
      "properties": [
        { "type": "title", "name": "Item" },
        {
          "type": "select",
          "name": "Category",
          "options": [
            { "name": "Venue", "color": "purple" },
            { "name": "Catering", "color": "orange" },
            { "name": "Flowers", "color": "pink" },
            { "name": "Photography", "color": "blue" },
            { "name": "Music", "color": "yellow" },
            { "name": "Attire", "color": "red" },
            { "name": "Transport", "color": "gray" },
            { "name": "Stationery", "color": "brown" },
            { "name": "Hair & Makeup", "color": "red" },
            { "name": "Cake", "color": "pink" },
            { "name": "Honeymoon", "color": "green" },
            { "name": "Miscellaneous", "color": "default" }
          ]
        },
        { "type": "number", "name": "Estimated Cost", "format": "pound" },
        { "type": "number", "name": "Actual Cost", "format": "pound" },
        { "type": "number", "name": "Deposit", "format": "pound" },
        { "type": "checkbox", "name": "Paid" },
        { "type": "date", "name": "Due Date" },
        {
          "type": "formula",
          "name": "Variance",
          "expression": "prop(\"Actual Cost\") - prop(\"Estimated Cost\")"
        },
        {
          "type": "relation",
          "name": "Vendor",
          "targetDatabaseId": "vendors",
          "dualProperty": false
        },
        { "type": "rich_text", "name": "Notes" }
      ],
      "views": [
        { "name": "Full Budget", "type": "table" },
        { "name": "By Category", "type": "board", "groupByProperty": "Category" },
        { "name": "Unpaid", "type": "table", "filters": [{ "propertyName": "Paid", "condition": "equals", "value": false }], "sorts": [{ "propertyName": "Due Date", "direction": "ascending" }] }
      ]
    },
    {
      "id": "guests",
      "name": "Guest List",
      "description": "Every invited guest with RSVP status, dietary requirements, and table assignment.",
      "icon": "👰",
      "cover": {
        "type": "external",
        "url": "https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=1920&q=80"
      },
      "properties": [
        { "type": "title", "name": "Full Name" },
        {
          "type": "select",
          "name": "RSVP",
          "options": [
            { "name": "Pending", "color": "yellow" },
            { "name": "Attending", "color": "green" },
            { "name": "Declined", "color": "red" }
          ]
        },
        { "type": "email", "name": "Email" },
        { "type": "phone_number", "name": "Phone" },
        { "type": "checkbox", "name": "Plus One" },
        { "type": "rich_text", "name": "Plus One Name" },
        {
          "type": "select",
          "name": "Side",
          "options": [
            { "name": "Bride", "color": "pink" },
            { "name": "Groom", "color": "blue" },
            { "name": "Both", "color": "purple" }
          ]
        },
        {
          "type": "multi_select",
          "name": "Dietary Requirements",
          "options": [
            { "name": "Vegetarian", "color": "green" },
            { "name": "Vegan", "color": "green" },
            { "name": "Gluten Free", "color": "yellow" },
            { "name": "Nut Allergy", "color": "red" },
            { "name": "Halal", "color": "orange" },
            { "name": "Kosher", "color": "blue" },
            { "name": "None", "color": "default" }
          ]
        },
        { "type": "rich_text", "name": "Table" },
        {
          "type": "select",
          "name": "Invitation Sent",
          "options": [
            { "name": "Not Sent", "color": "gray" },
            { "name": "Save the Date", "color": "yellow" },
            { "name": "Full Invite", "color": "green" }
          ]
        },
        { "type": "checkbox", "name": "Gift Received" },
        { "type": "checkbox", "name": "Thank You Sent" },
        { "type": "rich_text", "name": "Notes" }
      ],
      "views": [
        { "name": "All Guests", "type": "table" },
        { "name": "RSVP Board", "type": "board", "groupByProperty": "RSVP" },
        { "name": "Attending", "type": "table", "filters": [{ "propertyName": "RSVP", "condition": "equals", "value": "Attending" }] },
        { "name": "Dietary Needs", "type": "table", "filters": [{ "propertyName": "Dietary Requirements", "condition": "does_not_contain", "value": "None" }] }
      ]
    },
    {
      "id": "timeline",
      "name": "Planning Timeline",
      "description": "Every task needed to pull off the wedding, with deadlines and categories.",
      "icon": "📅",
      "cover": {
        "type": "external",
        "url": "https://images.unsplash.com/photo-1587271407850-8d438ca9fdf2?w=1920&q=80"
      },
      "properties": [
        { "type": "title", "name": "Task" },
        {
          "type": "status",
          "name": "Status"
        },
        {
          "type": "select",
          "name": "Category",
          "options": [
            { "name": "Venue & Catering", "color": "purple" },
            { "name": "Vendors", "color": "pink" },
            { "name": "Guests", "color": "blue" },
            { "name": "Attire", "color": "red" },
            { "name": "Legal & Admin", "color": "gray" },
            { "name": "Honeymoon", "color": "green" },
            { "name": "On the Day", "color": "orange" },
            { "name": "Other", "color": "default" }
          ]
        },
        { "type": "date", "name": "Due Date" },
        {
          "type": "select",
          "name": "When",
          "options": [
            { "name": "12+ months before", "color": "gray" },
            { "name": "9–12 months before", "color": "blue" },
            { "name": "6–9 months before", "color": "purple" },
            { "name": "3–6 months before", "color": "yellow" },
            { "name": "1–3 months before", "color": "orange" },
            { "name": "2–4 weeks before", "color": "red" },
            { "name": "Week of", "color": "red" },
            { "name": "Day of", "color": "pink" }
          ]
        },
        { "type": "checkbox", "name": "High Priority" },
        { "type": "rich_text", "name": "Notes" }
      ],
      "views": [
        { "name": "All Tasks", "type": "table" },
        { "name": "By Timeline", "type": "board", "groupByProperty": "When" },
        { "name": "Upcoming", "type": "table", "filters": [{ "propertyName": "Status", "condition": "does_not_equal", "value": "Done" }], "sorts": [{ "propertyName": "Due Date", "direction": "ascending" }] }
      ],
      "seedData": [
        { "Task": "Set your wedding date", "Category": "Legal & Admin", "When": "12+ months before", "High Priority": true },
        { "Task": "Agree your total budget", "Category": "Legal & Admin", "When": "12+ months before", "High Priority": true },
        { "Task": "Write your initial guest list", "Category": "Guests", "When": "12+ months before", "High Priority": true },
        { "Task": "Research and book your venue", "Category": "Venue & Catering", "When": "12+ months before", "High Priority": true },
        { "Task": "Book your photographer", "Category": "Vendors", "When": "12+ months before", "High Priority": true },
        { "Task": "Start dress shopping", "Category": "Attire", "When": "12+ months before", "High Priority": false },
        { "Task": "Announce your engagement", "Category": "Other", "When": "12+ months before", "High Priority": false },
        { "Task": "Book your caterer", "Category": "Venue & Catering", "When": "9–12 months before", "High Priority": true },
        { "Task": "Book your florist", "Category": "Vendors", "When": "9–12 months before", "High Priority": true },
        { "Task": "Book your music / DJ / band", "Category": "Vendors", "When": "9–12 months before", "High Priority": true },
        { "Task": "Book your videographer", "Category": "Vendors", "When": "9–12 months before", "High Priority": false },
        { "Task": "Book your officiant or celebrant", "Category": "Legal & Admin", "When": "9–12 months before", "High Priority": true },
        { "Task": "Send save the dates", "Category": "Guests", "When": "9–12 months before", "High Priority": true },
        { "Task": "Book hair and makeup artist", "Category": "Vendors", "When": "6–9 months before", "High Priority": false },
        { "Task": "Book and order wedding cake", "Category": "Vendors", "When": "6–9 months before", "High Priority": false },
        { "Task": "Book wedding transport", "Category": "Vendors", "When": "6–9 months before", "High Priority": false },
        { "Task": "Plan and book your honeymoon", "Category": "Honeymoon", "When": "6–9 months before", "High Priority": false },
        { "Task": "Choose wedding party attire", "Category": "Attire", "When": "6–9 months before", "High Priority": false },
        { "Task": "Create your gift list / registry", "Category": "Other", "When": "6–9 months before", "High Priority": false },
        { "Task": "Order wedding rings", "Category": "Other", "When": "6–9 months before", "High Priority": true },
        { "Task": "Send formal invitations", "Category": "Guests", "When": "3–6 months before", "High Priority": true },
        { "Task": "Arrange wedding insurance", "Category": "Legal & Admin", "When": "3–6 months before", "High Priority": true },
        { "Task": "Plan ceremony details with officiant", "Category": "Legal & Admin", "When": "3–6 months before", "High Priority": false },
        { "Task": "Book guest accommodation", "Category": "Venue & Catering", "When": "3–6 months before", "High Priority": false },
        { "Task": "Order wedding stationery (menus, place cards)", "Category": "Other", "When": "3–6 months before", "High Priority": false },
        { "Task": "Chase RSVPs and finalise guest list", "Category": "Guests", "When": "1–3 months before", "High Priority": true },
        { "Task": "Finalise menu with caterer", "Category": "Venue & Catering", "When": "1–3 months before", "High Priority": true },
        { "Task": "Final dress fitting", "Category": "Attire", "When": "1–3 months before", "High Priority": true },
        { "Task": "Create table seating plan", "Category": "Guests", "When": "1–3 months before", "High Priority": false },
