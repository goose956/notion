{
  "id": "podcast",
  "name": "Podcast OS",
  "databases": [
    {
      "dbId": "episodes",
      "name": "Episodes",
      "properties": [
        { "name": "Title",  "type": "title" },
        { "name": "Guest",  "type": "rich_text" },
        { "name": "Number", "type": "rich_text" },
        { "name": "Status", "type": "select",     "options": ["Planning", "Recorded", "Editing", "Published"] },
        { "name": "Notes",  "type": "rich_text" }
      ]
    },
    {
      "dbId": "documents",
      "name": "Documents",
      "properties": [
        { "name": "Title",   "type": "title" },
        { "name": "Type",    "type": "select",    "options": ["Episode Plan", "Show Notes", "Guest Outreach", "Transcript Summary"] },
        { "name": "Episode", "type": "rich_text" },
        { "name": "Content", "type": "rich_text" }
      ]
    }
  ],
  "onboarding": [
    { "id": "podcast-name",   "label": "Podcast Name",  "type": "text",   "placeholder": "e.g. The Growth Files" },
    { "id": "niche",          "label": "Niche / Genre", "type": "select", "options": ["Business & Entrepreneurship", "Personal Development", "Health & Wellness", "True Crime", "Comedy", "Technology", "Sports", "Education", "Arts & Culture", "Other"] },
    { "id": "format",         "label": "Format",        "type": "select", "options": ["Interview", "Solo", "Co-hosted", "Narrative / Storytelling"] },
    { "id": "episode-length", "label": "Episode Length","type": "select", "options": ["Under 20 mins", "20–45 mins", "45–60 mins", "60+ mins"] },
    { "id": "country",        "label": "Country",       "type": "text",   "placeholder": "e.g. United Kingdom" }
  ]
}
